# Toolshop Test Automation - Environment Variables
# Copy this file to .env and adjust the values if needed.
# All variables are optional - the defaults below are used when a value is missing.

# ============================================
# Application URLs
# ============================================
BASE_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com

# ============================================
# Execution
# ============================================
# Set to false to watch the browser while tests run
HEADLESS=true
