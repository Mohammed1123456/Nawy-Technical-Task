{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "specs/**/*",
    "pages/**/*",
    "apis/**/*",
    "fixtures/**/*",
    "data/**/*",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "test-results", "html-report"]
}
